# Environment variables — copy to .env for local testing, set in Vercel for production.
# Do not put real secrets in this file.

# Destination email for contact form submissions (FormSubmit).
# No account or API key needed. The contact form posts directly from the browser to
# FormSubmit; this email is injected into the built HTML at deploy time (see
# tools/build-vercel.mjs), so the address never lives in the source/repo.
# FormSubmit sends a one-time activation email to this address on the first submission —
# click the link once, then all future submissions arrive normally.
# Set this in the Vercel dashboard. For testing use a personal address; for production use info@ajplumbing.co.za.
CONTACT_FORM_TO_EMAIL=info@ajplumbing.co.za

# Production domain — injected into sitemap.xml and all canonical/OG URLs at build time.
# Set this in the Vercel dashboard once the final domain is confirmed.
# Example: https://ajplumbing.com  or  https://ajplumbing.co.za
SITE_URL=https://ajplumbing.co.za
