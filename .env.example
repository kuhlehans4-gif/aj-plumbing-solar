# Environment variables — copy to .env for local testing, set in Vercel for production.
# Do not put real secrets in this file.

# Destination email for contact form submissions (FormSubmit).
# No account or API key needed — FormSubmit sends a one-time activation email to this address
# on the very first submission. Click the link in that email once, then all future submissions arrive normally.
# For testing use a personal address; for production use info@ajplumbing.co.za.
CONTACT_FORM_TO_EMAIL=hans-kuhle@web.de

# Deployment
PUBLIC_SITE_URL=https://ajplumbing.co.za
