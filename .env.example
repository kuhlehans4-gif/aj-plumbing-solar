# Environment variables — copy to .env for local testing, set in Vercel for production.
# Do not put real secrets in this file.

# Destination email for contact form submissions.
# This must match the email address registered with the Web3Forms access key below.
CONTACT_FORM_TO_EMAIL=info@ajplumbing.co.za

# Web3Forms access key.
# To get a key: go to https://web3forms.com, enter the destination email and click "Create Access Key".
# The free plan allows 250 submissions/month.
# For testing use a personal email (e.g. hans-kuhle@web.de), for production use info@ajplumbing.co.za.
WEB3FORMS_ACCESS_KEY=

# Deployment
PUBLIC_SITE_URL=https://ajplumbing.co.za
